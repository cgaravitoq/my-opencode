{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-claude-auth@latest", "opencode-gemini-auth@latest"],
  "model": "anthropic/claude-sonnet-5",
  "default_agent": "reviewer",
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git symbolic-ref*": "allow",
      "git branch --show-current*": "allow",
      "git ls-files*": "allow"
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "figma-bridge": {
      "type": "local",
      "command": [
        "mcp-guard",
        "npx",
        "-y",
        "@gethopp/figma-mcp-bridge"
      ]
    },
    "memory-cloud": {
      "type": "remote",
      "url": "{env:MEMORY_CLOUD_URL}"
    },
    "braintrust": {
      "type": "remote",
      "url": "https://api-eu.braintrust.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:BRAINTRUST_API_KEY}"
      }
    }
  }
}
