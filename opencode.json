{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-claude-auth@latest", "opencode-gemini-auth@latest"],
  "model": "anthropic/claude-opus-4-7",
  "default_agent": "architect",
  "permission": {
    "*": "allow",
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "rm *": "ask"
    }
  },
  "agent": {
    "fixer": {
      "permission": {
        "doom_loop": "deny"
      }
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  }
}
