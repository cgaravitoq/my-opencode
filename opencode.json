{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-claude-auth@latest", "opencode-gemini-auth@latest"],
  "model": "anthropic/claude-sonnet-5",
  "default_agent": "reviewer",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow"
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "figma-bridge": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gethopp/figma-mcp-bridge"
      ]
    },
    "memory-cloud": {
      "type": "remote",
      "url": "{env:MEMORY_CLOUD_URL}"
    }
  }
}
